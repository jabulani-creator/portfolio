# Copy on the server only (never commit the real file):
#   cp .env.production.example .env.production
#   nano .env.production
#
# Load before build (NEXT_PUBLIC_* are baked in at build time):
#   set -a && . ./.env.production && set +a && npm run build

# --- Required (Sanity public site + /admin Studio) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=43qkdan1
NEXT_PUBLIC_SANITY_DATASET=production

# Public URL (sitemap, robots, canonical — use your live domain)
NEXT_PUBLIC_SITE_URL=https://thewebsiteguy.zm

# Optional Studio sidebar title
# NEXT_PUBLIC_SANITY_STUDIO_TITLE=Portfolio CMS

# --- PM2 / process (not Next.js built-ins — used by ecosystem.config.cjs) ---
PORT=3003
PM2_APP_NAME=portfolio-frontend

# --- Optional: only if you run npm run seed:sanity ON the server ---
# SANITY_API_TOKEN=
