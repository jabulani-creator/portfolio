# Server only: cp .env.production.example .env.production && nano .env.production
# No backticks around URLs. Never commit .env.production.

# --- PM2 (must match ~/apps/PORTS.md and deploy_frontend.sh) ---
PORT=3003
PM2_APP_NAME=portfolio-frontend

# --- Sanity (required; NEXT_PUBLIC_* are baked in at npm run build) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Public site URL — use HTTPS domain in production (not raw IP:port)
NEXT_PUBLIC_SITE_URL=https://thewebsiteguy.zm
# Staging only example: http://167.233.68.200:3003
# Later with domain: NEXT_PUBLIC_SITE_URL=https://thewebsiteguy.zm

# NEXT_PUBLIC_SANITY_STUDIO_TITLE=Portfolio CMS

# Optional: npm run seed:sanity on server only
# SANITY_API_TOKEN=
