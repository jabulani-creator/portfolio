# Sanity — one project only (copy this file to .env.local)

# From sanity.io/manage → YOUR project → Settings → Project ID (required — not optional)
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Usually "production" (default dataset on new projects)
NEXT_PUBLIC_SANITY_DATASET=production

# Optional label in /admin sidebar
# NEXT_PUBLIC_SANITY_STUDIO_TITLE=Portfolio CMS

# API → Tokens → Editor (for npm run seed:sanity only — never commit)
SANITY_API_TOKEN=

# Set to true to mark seeded case studies Published immediately
# SEED_PUBLISH=false

# Production deploy (Hetzner): copy .env.production.example → .env.production on the server
# See docs/16-deploy-hetzner-portfolio.md
# NEXT_PUBLIC_SITE_URL=https://thewebsiteguy.zm
